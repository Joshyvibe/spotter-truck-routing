# Copy to backend/.env for local runs outside Docker. Never commit the real file.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter
REDIS_URL=redis://localhost:6379/0
TOMTOM_API_KEY=
ROUTING_PROVIDER=tomtom      # tomtom | osrm | fixture
WEATHER_PROVIDER=openmeteo   # openmeteo | fixture
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
